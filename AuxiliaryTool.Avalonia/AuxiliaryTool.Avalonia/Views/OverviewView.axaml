<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="AuxiliaryTool.Avalonia.Views.OverviewView"
             Background="#FFF9F9F9">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 数据面板 -->
    <Border Grid.Row="0" BorderBrush="#FFCCCCCC" BorderThickness="1" Background="#FFFFFFFF" Padding="15,15,15,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Data overview" FontSize="18" FontFamily="Century Gothic" Foreground="#FF333333" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" x:Name="DateLabel" Text="--" FontSize="14" FontFamily="Century Gothic" Foreground="#FF666666" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
          <Button x:Name="SelectA01Btn" Content="Select the current class as A01" Click="ClassButton_Click"
                  Background="#FF39C5BB" Foreground="#FFFFFFFF" Padding="16,6" CornerRadius="4" FontSize="12"/>
          <Button x:Name="SelectA02Btn" Content="Select the current class as A02" Click="ClassButton_Click"
                  Background="#FF1EAEE7" Foreground="#FFFFFFFF" Padding="16,6" CornerRadius="4" FontSize="12"/>
        </StackPanel>

        <Grid Grid.Row="3" ColumnDefinitions="*,*" Margin="0,0,0,5">
          <Border Grid.Column="0" Background="#FF1EAEE7" CornerRadius="5" Padding="20" Margin="0,0,20,0" Height="209">
            <Grid>
              <TextBlock Text="A01 Data Length" FontSize="15" FontWeight="Bold" FontFamily="Century Gothic" Foreground="#FFFFFFFF" VerticalAlignment="Top"/>
              <TextBlock x:Name="DataLengthLabel1" Text="--" FontSize="36" FontWeight="Bold" FontFamily="Century Gothic" Foreground="#FFFFFFFF" VerticalAlignment="Center" Margin="0,-20,0,0"/>
              <TextBlock x:Name="SubLabel1" Text="--" FontSize="14" FontFamily="Century Gothic" Foreground="#FFFFFFFF" VerticalAlignment="Bottom" Opacity="0.9"/>
              <TextBlock Text="&#128200;" FontSize="28" Foreground="#FFFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.7"/>
            </Grid>
          </Border>
          <Border Grid.Column="1" Background="#FF39C5BB" CornerRadius="5" Padding="20" Margin="20,0,0,0" Height="209">
            <Grid>
              <TextBlock Text="A02 Data Length" FontSize="15" FontWeight="Bold" FontFamily="Century Gothic" Foreground="#FFFFFFFF" VerticalAlignment="Top"/>
              <TextBlock x:Name="DataLengthLabel2" Text="--" FontSize="36" FontWeight="Bold" FontFamily="Century Gothic" Foreground="#FFFFFFFF" VerticalAlignment="Center" Margin="0,-20,0,0"/>
              <TextBlock x:Name="SubLabel2" Text="--" FontSize="14" FontFamily="Century Gothic" Foreground="#FFFFFFFF" VerticalAlignment="Bottom" Opacity="0.9"/>
              <TextBlock Text="&#128200;" FontSize="28" Foreground="#FFFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.7"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <!-- 图表区域 -->
    <Border Grid.Row="1" Background="#FFF9F9F9" Padding="20">
      <lvc:CartesianChart x:Name="AverageChart" Background="#FFFFFFFF"/>
    </Border>
  </Grid>
</UserControl>
