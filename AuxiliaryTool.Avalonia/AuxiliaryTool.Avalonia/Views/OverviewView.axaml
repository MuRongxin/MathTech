<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AuxiliaryTool.Avalonia.Views.OverviewView"
             Background="#FF1E1E1E">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="数据看板" FontSize="24" FontWeight="Bold"
               Foreground="White" Margin="0,0,0,20"/>

    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,20">
      <Border Grid.Column="0" Background="#FF2D5F8B" CornerRadius="8" Padding="20" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="A01 班级" FontSize="14" Foreground="#FFAAAAAA"/>
          <TextBlock x:Name="A01Count" Text="0" FontSize="36" FontWeight="Bold" Foreground="White"/>
          <TextBlock x:Name="A01Avg" Text="平均分: --" FontSize="14" Foreground="#FFDDDDDD" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#FF2D8B7A" CornerRadius="8" Padding="20" Margin="10,0,0,0">
        <StackPanel>
          <TextBlock Text="A02 班级" FontSize="14" Foreground="#FFAAAAAA"/>
          <TextBlock x:Name="A02Count" Text="0" FontSize="36" FontWeight="Bold" Foreground="White"/>
          <TextBlock x:Name="A02Avg" Text="平均分: --" FontSize="14" Foreground="#FFDDDDDD" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#FF252525" CornerRadius="8" Padding="16">
      <StackPanel>
        <TextBlock Text="最近考试日期" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
        <TextBlock x:Name="RecentDates" Text="--" FontSize="14" Foreground="#FFCCCCCC"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
