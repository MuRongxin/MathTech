<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="AuxiliaryTool.Avalonia.Views.ScoreAnalysisView"
             Background="#FF1E1E1E">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 工具栏 -->
    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
      <ComboBox x:Name="DisplayCountBox" Width="100" Margin="0,0,8,0"
                SelectedIndex="0" SelectionChanged="DisplayCountBox_SelectionChanged">
        <ComboBoxItem Content="All"/>
        <ComboBoxItem Content="4"/>
        <ComboBoxItem Content="5"/>
        <ComboBoxItem Content="6"/>
        <ComboBoxItem Content="7"/>
        <ComboBoxItem Content="8"/>
        <ComboBoxItem Content="9"/>
        <ComboBoxItem Content="10"/>
      </ComboBox>

      <ComboBox x:Name="StudentBox" Width="180" Margin="0,0,8,0"
                PlaceholderText="直接选择学生"/>

      <Button Content="下一组" Click="NextGroup_Click"
              Background="#FF9B59B6" Foreground="White" Margin="0,0,8,0" Padding="12,6"/>
      <Button Content="清空图表" Click="Clear_Click"
              Background="#FF555555" Foreground="White" Margin="0,0,8,0" Padding="12,6"/>
      <Button x:Name="LastWeekButton" Content="最近7次" Click="LastWeek_Click"
              Background="#FF00C0C0" Foreground="White" Margin="0,0,8,0" Padding="12,6"/>
      <Button Content="客观分" Click="HalfScore_Click"
              Background="#FF39C5BB" Foreground="White" Margin="0,0,8,0" Padding="12,6"/>
      <Button Content="全部分" Click="AllScore_Click"
              Background="#FF3A9BDC" Foreground="White" Padding="12,6"/>
    </WrapPanel>

    <!-- 图表区 -->
    <Border Grid.Row="1" Background="#FF252525" CornerRadius="8" Padding="8">
      <lvc:CartesianChart x:Name="Chart"
                          LegendPosition="Right"
                          Background="#FF252525"/>
    </Border>
  </Grid>
</UserControl>
