<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AuxiliaryTool.Avalonia.Views.RandomView"
             Background="#FF1E1E1E">
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 左侧控制区 -->
    <StackPanel Grid.Column="0" Margin="0,0,20,0">
      <Button x:Name="StartButton" Content="开始随机" Click="StartButton_Click"
              Background="#FF39C5BB" Foreground="White" FontSize="18"
              Padding="20,12" CornerRadius="8" HorizontalAlignment="Stretch"/>

      <Border Background="#FF252525" CornerRadius="8" Padding="12" Margin="0,20,0,0">
        <StackPanel>
          <TextBlock Text="历史记录" Foreground="#FFAAAAAA" FontSize="14" Margin="0,0,0,8"/>
          <ScrollViewer Height="400">
            <StackPanel x:Name="HistoryPanel"/>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- 右侧显示区 -->
    <Border Grid.Column="1" Background="#FF252525" CornerRadius="8">
      <Grid>
        <TextBlock x:Name="ResultLabel"
                   Text="点击左侧按钮开始随机抽人"
                   FontSize="48" FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
