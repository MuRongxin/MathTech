<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AuxiliaryTool.Avalonia.Views.RandomView"
             Background="#FFF9F9F9">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="494"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 上部区域 -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="162"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="226"/>
      </Grid.ColumnDefinitions>

      <!-- 左侧大按钮 -->
      <Button Grid.Column="0" x:Name="StartRandomButton" Content="Start Random" Click="StartButton_Click"
              Background="#FFE8E8E8" Foreground="#FF888888" FontSize="18"
              FontWeight="Bold" FontFamily="Californian FB"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              CornerRadius="0" BorderThickness="0"/>

      <!-- 中间结果 -->
      <Grid Grid.Column="1" Background="#FFF9F9F9">
        <TextBlock x:Name="ResultLabel"
                   Text="Hi~ o(*￣▽￣*)ブ&#10;你准备好了吗？"
                   FontSize="24" FontWeight="Bold" FontFamily="SimHei"
                   Foreground="#FF333333"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"/>
      </Grid>

      <!-- 右侧历史记录 -->
      <Border Grid.Column="2" Background="#FFF5F5F5" BorderBrush="#FFDDDDDD" BorderThickness="1,0,0,0" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" BorderBrush="#FFDDDDDD" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,10">
            <TextBlock Text="历史记录" FontSize="14" Foreground="#FF666666" FontWeight="Bold"/>
          </Border>
          <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="HistoryPanel"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- 底部动画区域 -->
    <Grid Grid.Row="1" Background="#FF000000">
      <Border Width="600" Height="200" Background="#FF222222"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              CornerRadius="4">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF333333" Offset="0"/>
            <GradientStop Color="#FF444444" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Grid>
  </Grid>
</UserControl>
