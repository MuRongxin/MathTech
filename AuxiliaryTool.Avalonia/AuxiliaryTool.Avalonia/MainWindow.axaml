<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="AuxiliaryTool.Avalonia.MainWindow"
        Title="Auxiliary Tool"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#FFF9F9F9">

  <Window.Styles>
    <Style Selector="Button.nav-btn">
      <Setter Property="Width" Value="212"/>
      <Setter Property="Height" Value="61"/>
      <Setter Property="Margin" Value="3,3"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="Foreground" Value="#FF666666"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.nav-btn:pointerover">
      <Setter Property="Background" Value="#FF1EAEE7"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
    </Style>
    <Style Selector="Button.nav-btn.active">
      <Setter Property="Background" Value="#FF1EAEE7"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
    </Style>
  </Window.Styles>

  <Grid>
    <!-- 左侧边栏 -->
    <Border Width="217" HorizontalAlignment="Left"
            Background="#FFFFFFFF"
            BorderBrush="#FFDDDDDD" BorderThickness="0,0,1,0">
      <StackPanel Margin="0,20,0,0">
        <Ellipse Width="75" Height="75" HorizontalAlignment="Center">
          <Ellipse.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF3A9BDC" Offset="0"/>
              <GradientStop Color="#FF39C5BB" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <TextBlock Text="Hello Teacher" HorizontalAlignment="Center"
                   Margin="0,8,0,20" Foreground="#FF555555" FontSize="14"/>

        <Button Classes="nav-btn active" x:Name="NavOverview" Content="主界面" Click="NavButton_Click"/>
        <Button Classes="nav-btn" x:Name="NavRandom" Content="随机点名" Click="NavButton_Click"/>
        <Button Classes="nav-btn" x:Name="NavScore" Content="成绩曲线" Click="NavButton_Click"/>
        <Button Classes="nav-btn" Content="Score Entry"/>
        <Button Classes="nav-btn" Content="Setting"/>
      </StackPanel>
    </Border>

    <!-- 内容区域 -->
    <ContentControl x:Name="MainContent" Margin="217,0,0,0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
  </Grid>
</Window>
